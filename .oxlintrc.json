{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.data/**",
    "**/.nitro/**",
    "**/dist/**",
    "**/*.json",
    "**/*.yaml",
    "**/*.yml"
  ]
}
